# --- User media (too large for git; backup separately) ---
/takes/*
!/takes/.gitkeep

# --- Render artifacts & intermediates ---
/runs/**/*.mp4
/runs/**/*.mov
/runs/**/*.wav
/runs/**/*.jpg
/runs/**/comp/
/runs/**/probe-trial/
/runs/**/transcripts/
/runs/**/transcripts-voice/

# Keep small edit metadata if present (json/md)  not ignored

# --- Generated per-run compositions (font + gsap copies, rebuilt by generate_comp) ---
/runs/**/comp-back/
# --- Throwaway test runs ---
/runs/tst*/

# --- Brand: tokens and fonts are committed, the strategy documents are not (public repo) ---
/refs/brandbook/brandbook.md
/refs/brandbook/landing.md
/refs/brandbook/canonical.md
/refs/brandbook/fonts/inter.zip

# --- media-use cache: resolved assets are copied into sfx/ ---
/.media/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- OS / IDE ---
.DS_Store
Thumbs.db
*.log
~$*
*.locked

# --- Whisper model (download via tools/download-whisper-model.ps1) ---
*.bin

# --- Script texts: private working material, only the README is tracked ---
/script/*
!/script/.gitkeep
!/script/README.md
/runs/**/comp-plan/
